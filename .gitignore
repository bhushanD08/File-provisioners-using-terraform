# Terraform working directories and local state
**/.terraform/*
*.tfstate
*.tfstate.*

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Local Terraform crash logs
crash.log
crash.*.log

# Override files are intended for local customization
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep Terraform dependency lock files (for reproducible provider versions)
!**/.terraform.lock.hcl